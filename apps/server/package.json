    "@aif/plugin-exporter-skill": "workspace:*",
    "@aif/workflow-ir": "workspace:*",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@hono/node-server": "^2.1.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "typebox": "^1.3.36",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
