# 数据库
DATABASE_URL=postgres://aif:aif@localhost:5433/all_in_flow
POSTGRES_PORT=5433
POSTGRES_USER=aif
POSTGRES_PASSWORD=aif
POSTGRES_DB=all_in_flow

# 模型
DEEPSEEK_API_KEY=
# 模型请求地址，默认官方地址；可改为代理或私有网关（OpenAI 兼容接口，需包含 /v1 等路径前缀）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 自定义模型清单（Pi 的 models.json 格式）；本地开发设为 config/models.json
MODELS_JSON_PATH=
AGENT_MODEL=deepseek/deepseek-flash
# 访谈 Agent 的思考等级：off、minimal、low、medium、high；默认 high，关闭可以更快但更容易漏调用记录工具
AGENT_THINKING_LEVEL=high
WORKFLOW_MODEL=deepseek/deepseek-v4-pro

# ERP 登录
ERP_BASE_URL=https://erp.tourmind.cn
SSO_APP_CODE=
SESSION_COOKIE_SECURE=false
SESSION_VERIFY_INTERVAL_SECONDS=300
ADMIN_USERNAMES=

# 图片识别（千问，经与 DeepSeek 相同的代理）；填模型 ID 才开启图片上传
VISION_MODEL_ID=
VISION_THINKING=false

# 分享
PUBLIC_BASE_URL=http://localhost
SHARE_PUBLIC_ENABLED=false

# 配额
DAILY_TOKEN_QUOTA_PER_USER=2000000
DAILY_COST_LIMIT_USD=20
MAX_TURNS_PER_CONVERSATION=80

# 授权管理（头像菜单）与导出 n8n 工作流：用户保存的 n8n MCP token 用这个密钥加密存放。
# 32 字节，64 位十六进制，生成：openssl rand -hex 32。不配置则授权管理和 n8n 导出关闭。
# 请妥善保管：丢失后已保存的授权无法解密，需要用户重新添加。
# AUTH_SECRET_KEY=
# 用户填的 n8n 地址默认只允许 https 且不能指向内网；n8n 部署在内网时设为 true（仅内部部署）
# MCP_ALLOW_PRIVATE_HOSTS=false
